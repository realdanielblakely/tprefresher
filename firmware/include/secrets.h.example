#pragma once
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"
#define API_BASE_URL "http://192.168.1.50:3000"
#define API_TOKEN ""
// Over-the-air updates. The board is reachable at OTA_HOSTNAME.local once flashed
// over USB the first time. Set OTA_PASSWORD in the shell to match when uploading.
#define OTA_HOSTNAME "tprefresher"
#define OTA_PASSWORD "choose-an-ota-password"
// Log lines are mirrored to this UDP port as a broadcast, so the board stays
// debuggable once the USB cable is gone.
#define LOG_UDP_PORT 4444
